<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" session="false" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:url value="/css/tailwind.css" var="appCssUrl" />
<!DOCTYPE html><html lang="en"><head>
    <meta name="description" content="<c:out value='${learningPackage.name}' /> at DriveSpark Academy. Explore lessons, learning resources and driving school information.">
    <meta name="theme-color" content="#0B1120">
    <link rel="icon" type="image/svg+xml" href="<c:url value='/images/favicon.svg' />"><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><c:out value="${learningPackage.name}" /> | DriveSpark</title><link rel="stylesheet" href="<c:out value='${appCssUrl}' />"></head>
<body><%@ include file="/WEB-INF/views/common/navbar.jspf" %><main id="main-content" class="ds-container ds-section"><nav class="ds-breadcrumbs" aria-label="Breadcrumb"><a href="<c:url value='/packages' />">Packages</a><span aria-hidden="true">/</span><span aria-current="page"><c:out value="${learningPackage.name}" /></span></nav><section class="ds-package-detail-hero"><div><p class="ds-eyebrow">DRIVE YOUR NEXT STEP</p><span class="ds-package-tag" data-type="<c:out value='${learningPackage.type}' />"><c:out value="${learningPackage.type}" /></span><h1><c:out value="${learningPackage.name}" /></h1><p class="ds-page-intro"><c:out value="${learningPackage.description}" /></p></div></section><div class="ds-package-detail-grid"><section class="ds-package-detail-copy"><h2>What's included</h2><p>A structured learning path with instructor-guided practice and progress recorded after your lessons.</p><ul><li>Individual driving lessons</li><li>Instructor feedback and skill notes</li><li>Lesson balance tracked in your student account</li></ul><h2>Designed for your learning goals</h2><p>Review the course details and choose an active package that fits the vehicle type and experience you want to build.</p></section><aside class="ds-enroll-card"><p class="ds-eyebrow">PACKAGE DETAILS</p><p class="ds-package-price">LKR <c:out value="${learningPackage.price}" /></p><dl><div><dt>Course type</dt><dd><c:out value="${learningPackage.type}" /></dd></div><div><dt>Driving lessons</dt><dd><c:out value="${learningPackage.lessonCount}" /></dd></div><div><dt>Duration</dt><dd><c:out value="${learningPackage.durationHours}" /> hours</dd></div></dl><c:choose><c:when test="${navRole eq 'STUDENT'}"><form method="post" action="<c:url value='/enrollments' />"><input type="hidden" name="<c:out value='${csrfParameterName}' />" value="<c:out value='${csrfToken}' />"><input type="hidden" name="packageId" value="<c:out value='${learningPackage.id}' />"><button class="ds-button ds-button-accent w-full" type="submit">Enroll in this package</button></form><p>Payment is simulated for the course project.</p></c:when><c:when test="${navRole eq 'PUBLIC'}"><a class="ds-button ds-button-accent w-full" href="<c:url value='/login' />">Log in to enroll</a><p>Sign in or create a student account to start enrollment.</p></c:when></c:choose></aside></div></main><%@ include file="/WEB-INF/views/common/footer.jspf" %></body></html>
