<%--
============================================================
MEMBER   : IT26101137 - [Name]
MODULE   : Reviews and Reports
FILE     : reports.jsp
WHAT IT DOES (simple words): Keeps reviews and reports details clear and safe for the school.
REAL-LIFE EXAMPLE: Like a feedback book and a school manager counting its records.
OOP USED : See labelled classes and methods below; presentation files display their results
CRUD     : CREATE, READ, UPDATE, DELETE for reviews; reports READ saved data
============================================================
--%>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" session="false" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="School totals, accessible charts, printable reports and CSV export from saved records."><meta name="theme-color" content="#0B1120">
<title>School reports | DriveSpark Academy</title>
<link rel="icon" type="image/svg+xml" href="<c:url value='/images/favicon.svg' />">
<link rel="stylesheet" href="<c:url value='/css/tailwind.css' />">
<link rel="stylesheet" href="<c:url value='/css/report.css' />">
</head><body class="ds-account-page"><%@ include file="/WEB-INF/views/common/navbar.jspf" %>
<main id="main-content" class="ds-container ds-section ds-dashboard-shell">
<%@ include file="/WEB-INF/views/common/dashboard-sidebar.jspf" %><div class="ds-dashboard-content">

<%-- AdminReportController supplies ReportSection rows calculated from existing saved records only. --%>
<header class="mb-8 ds-report-header"><p class="ds-eyebrow">SCHOOL OVERVIEW</p><h1>Driving school report</h1>
<p><c:out value="${reportSchool}" /></p><p>Generated on <c:out value="${reportGenerated}" /></p><p>Generated by <c:out value="${reportAdmin}" /></p><p>Reporting period: All records</p>
<div class="no-print mt-5 flex gap-3"><a class="ds-button" href="<c:url value='/admin/reports/export.csv' />">Download full CSV</a><button class="ds-button ds-button-outline" data-print type="button">Print report</button></div></header>
<p class="mb-6 text-sm">Revenue includes confirmed package payments, grouped by enrollment month because payment dates are not stored. Lesson usage includes all assigned statuses.</p>
<div class="ds-report-grid grid gap-6">
<c:forEach items="${reports}" var="report"><section class="ds-card ds-report-section"><div class="flex flex-wrap justify-between gap-3"><h2><c:out value="${report.title}" /></h2><a class="no-print ds-home-text-link" href="<c:url value='/admin/reports/export.csv'><c:param name='section' value='${report.key}' /></c:url>">Download section CSV</a></div>
<div class="safe-scroll mt-5"><table class="ds-report-table w-full text-sm"><caption class="sr-only"><c:out value="${report.title}" /></caption><thead><tr><c:forEach items="${report.headings}" var="heading"><th scope="col"><c:out value="${heading}" /></th></c:forEach></tr></thead><tbody>
<c:choose><c:when test="${empty report.rows}"><tr><td colspan="${report.headings.size()}">No records for this period</td></tr></c:when><c:otherwise><c:forEach items="${report.rows}" var="cells"><tr><c:forEach items="${cells}" var="cell"><td><c:out value="${cell}" /></td></c:forEach></tr></c:forEach></c:otherwise></c:choose>
</tbody></table></div></section></c:forEach></div>
</div></main><%@ include file="/WEB-INF/views/common/footer.jspf" %></body></html>
