<%-- Module owner: IT26101137 --%>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" session="false" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:url value="/css/tailwind.css" var="appCssUrl" />
<!DOCTYPE html>
<html lang="en"><head>
    <meta name="description" content="Moderate reviews at DriveSpark Academy. Explore lessons, learning resources and driving school information.">
    <meta name="theme-color" content="#0B1120">
    <link rel="icon" type="image/svg+xml" href="<c:url value='/images/favicon.svg' />"><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Moderate reviews</title><link rel="stylesheet" href="<c:out value='${appCssUrl}' />"></head>
<body><%@ include file="/WEB-INF/views/common/navbar.jspf" %><main id="main-content" class="ds-container ds-section ds-dashboard-shell"><%@ include file="/WEB-INF/views/common/dashboard-sidebar.jspf" %><div class="ds-dashboard-content"><p class="ds-eyebrow">ADMINISTRATION</p><h1>Moderate reviews</h1><%@ include file="/WEB-INF/views/common/components/review-tabs.jspf" %><c:if test="${not empty success}"><p role="status"><c:out value="${success}" /></p></c:if>
<form method="get" action="<c:url value='/admin/reviews' />"><label>Status <select name="status"><option value="">All</option><option value="PENDING">Pending</option><option value="APPROVED">Approved</option><option value="HIDDEN">Hidden</option></select></label><button type="submit">Filter</button></form><c:choose><c:when test="${empty reviews}"><p>No reviews have been submitted.</p></c:when><c:otherwise><c:forEach items="${reviews}" var="review"><article class="ds-feature-card"><h2><c:out value="${review.rating}" /> / 5</h2><p><c:out value="${review.comment}" /></p><p>Student: <c:out value="${review.studentId}" /> Â· Status: <span class="status-badge" data-status="<c:out value='${review.status}' />"><c:out value="${review.status}" /></span></p><form method="post" action="<c:url value='/admin/reviews/approve' />"><input type="hidden" name="<c:out value='${csrfParameterName}' />" value="<c:out value='${csrfToken}' />"><input type="hidden" name="reviewId" value="<c:out value='${review.id}' />"><button type="submit">Approve</button></form><form method="post" action="<c:url value='/admin/reviews/hide' />"><input type="hidden" name="<c:out value='${csrfParameterName}' />" value="<c:out value='${csrfToken}' />"><input type="hidden" name="reviewId" value="<c:out value='${review.id}' />"><button type="submit">Hide</button></form><form method="post" action="<c:url value='/admin/reviews/delete' />" data-confirm="Delete this review?"><input type="hidden" name="<c:out value='${csrfParameterName}' />" value="<c:out value='${csrfToken}' />"><input type="hidden" name="reviewId" value="<c:out value='${review.id}' />"><button type="submit">Delete</button></form></article></c:forEach></c:otherwise></c:choose>
</div></main><%@ include file="/WEB-INF/views/common/footer.jspf" %></body></html>
