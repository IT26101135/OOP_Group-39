<%--
============================================================
MEMBER   : IT26101134 - [Name]
MODULE   : Bookings, FIFO queue and scheduling
FILE     : booking-card.jspf
WHAT IT DOES (simple words): Shows booking card information and forms.
REAL-LIFE EXAMPLE: A reception waiting line handles the oldest request first.
OOP USED : Not applicable (JSP presentation)
CRUD     : See the labelled operations; model and view files support these operations.
============================================================
--%>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%-- AdminBookingController supplies one booking; assignment changes remain service-checked. --%>
<%-- AdminBookingController supplies this record card. --%>
<article class="ds-feature-card"><div class="mb-4 flex flex-wrap items-start justify-between gap-3"><div><p class="ds-eyebrow"><c:out value="${'LESSON'}" /></p><h3 class="text-xl"><c:out value="${publicDisplay.date(booking.startTime.toLocalDate())}" /></h3><p><c:out value="${publicDisplay.time(booking.startTime.toLocalTime())}" /> to <c:out value="${publicDisplay.time(booking.endTime.toLocalTime())}" /></p></div><span class="status-badge" data-status="${booking.status}"><c:out value="${publicDisplay.label(booking.status)}" /></span></div>
<p class="my-3"><a class="ds-home-text-link" href="<c:url value='/bookings/${booking.id}/details' />">View booking details</a></p>
<p>Package: <c:out value="${bookingPackages[booking.id].packageName}" /> &middot; Course type: <c:out value="${publicDisplay.label(bookingPackages[booking.id].type)}" /></p>
<p>Student <c:out value="${accountDisplay.person(booking.studentId)}" /> - Enrollment <c:out value="${accountDisplay.enrollment(booking.enrollmentId)}" /></p>
<c:if test="${not empty booking.instructorId}"><p>Instructor <c:out value="${accountDisplay.person(booking.instructorId)}" /> - Vehicle <c:out value="${accountDisplay.vehicle(booking.vehicleId)}" /></p></c:if>
<c:if test="${booking.status eq 'PENDING'}"><c:choose><c:when test="${booking.instructorId == null}"><p class="mt-3"><span class="ds-queue-position">Position in waiting list <c:out value="${queuePositions[booking.id]}" /></span></p><p class="mt-2">Use the queue panel to handle the oldest unassigned request first.</p></c:when><c:otherwise><p class="mt-3 text-indigo-200">Waiting for instructor approval.</p></c:otherwise></c:choose></c:if>
<c:if test="${not empty booking.rejectionReason}"><p class="mt-3 rounded-xl border border-amber-300/20 bg-amber-400/10 p-3 text-amber-100"><c:out value="${booking.rejectionReason}" /></p></c:if>
<c:if test="${booking.status eq 'CONFIRMED'}"><details class="mt-5"><summary>Manage this confirmed lesson</summary>
<%@ include file="/WEB-INF/views/common/components/attendance-time.jspf" %>
<%-- AdminBookingController rechecks resource conflicts when reassignment is submitted. --%>
<%-- AdminBookingController supplies this form and its original field names. --%>
<form class="mt-4 grid gap-4 sm:grid-cols-2" method="post" action="<c:url value='/admin/bookings/reassign' />"><input type="hidden" name="<c:out value='${csrfParameterName}' />" value="<c:out value='${csrfToken}' />"><input type="hidden" name="bookingId" value="${booking.id}"><div><label for="reassign-${booking.id}-instructor">Instructor</label><select class="block w-full" id="reassign-${booking.id}-instructor" name="instructorId" required><c:forEach items="${instructors}" var="instructor"><option value="${instructor.id}" <c:if test="${instructor.id eq booking.instructorId}">selected</c:if>><c:out value="${instructor.name}" /></option></c:forEach></select></div><div><label for="reassign-${booking.id}-vehicle">Vehicle</label><select class="block w-full" id="reassign-${booking.id}-vehicle" name="vehicleId" required><c:forEach items="${vehicles}" var="vehicle"><option value="${vehicle.id}" <c:if test="${vehicle.id eq booking.vehicleId}">selected</c:if>><c:out value="${vehicle.registrationNumber}" /> - <c:out value="${vehicle.make}" /> <c:out value="${vehicle.model}" /></option></c:forEach></select></div><div class="sm:col-span-2"><button class="ds-button" type="submit">Reassign lesson</button></div></form>
<%-- AdminBookingController supplies this form and its original field names. --%>
<form class="mt-5" method="post" action="<c:url value='/admin/bookings/complete' />"><input type="hidden" name="<c:out value='${csrfParameterName}' />" value="<c:out value='${csrfToken}' />"><input type="hidden" name="bookingId" value="${booking.id}"><button class="ds-button ds-button-outline" type="submit" <c:if test="${not attendanceReady}">disabled aria-describedby="attendance-${booking.id}"</c:if>>Mark completed</button></form>
<%-- AdminBookingController requires and saves a reason for a forced cancellation. --%>
<%-- AdminBookingController supplies this form and its original field names. --%>
<form class="mt-5 border-t border-white/10 pt-5" method="post" action="<c:url value='/admin/bookings/force-cancel' />" data-confirm="Cancel this lesson? Add a reason so the student knows why." data-confirm-reason="true"><input type="hidden" name="<c:out value='${csrfParameterName}' />" value="<c:out value='${csrfToken}' />"><input type="hidden" name="bookingId" value="${booking.id}"><label for="cancel-reason-${booking.id}">Reason</label><input class="block w-full" id="cancel-reason-${booking.id}" name="reason" maxlength="300" required><button class="ds-button ds-button-danger mt-3" type="submit">Cancel lesson</button></form></details></c:if>
</article>