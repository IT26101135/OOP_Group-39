<%-- Module owner: IT26101134 --%>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" session="false" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:url value="/css/tailwind.css" var="appCssUrl" />
<!DOCTYPE html>
<html lang="en"><head>
    <meta name="description" content="Manage lesson requests at DriveSpark Academy. Explore lessons, learning resources and driving school information.">
    <meta name="theme-color" content="#0B1120">
    <link rel="icon" type="image/svg+xml" href="<c:url value='/images/favicon.svg' />"><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Manage lesson requests</title><link rel="stylesheet" href="<c:out value='${appCssUrl}' />"></head>
<body><%@ include file="/WEB-INF/views/common/navbar.jspf" %><main id="main-content" class="ds-container ds-section ds-dashboard-shell"><%@ include file="/WEB-INF/views/common/dashboard-sidebar.jspf" %><div class="ds-dashboard-content"><h1>Manage lesson requests</h1><c:if test="${not empty success}"><p role="status"><c:out value="${success}" /></p></c:if>
<form method="get" action="<c:url value='/admin/bookings' />"><label>From <input type="date" name="from" value="<c:out value='${filterFrom}' />"></label><label>To <input type="date" name="to" value="<c:out value='${filterTo}' />"></label><label>Instructor ID <input name="instructorId" value="<c:out value='${filterInstructor}' />"></label><label>Vehicle ID <input name="vehicleId" value="<c:out value='${filterVehicle}' />"></label><label>Status <select name="status"><option value="">All</option><option value="PENDING">Pending</option><option value="CONFIRMED">Confirmed</option><option value="COMPLETED">Completed</option><option value="CANCELLED">Cancelled</option><option value="NO_SHOW">No-show</option><option value="REJECTED">Rejected</option></select></label><button type="submit">Filter schedule</button></form><section><h2>Pending requests in FIFO order</h2><c:choose><c:when test="${empty pendingQueue}"><p>No pending requests.</p></c:when><c:otherwise><ol><c:forEach items="${pendingQueue}" var="queued"><li><c:out value="${queued.id}" /> ? <c:out value="${queued.startTime}" /> ? Student <c:out value="${queued.studentId}" /></li></c:forEach></ol></c:otherwise></c:choose></section><p>Pending request queue: <c:out value="${queueSize}" /> requests. Oldest request must be handled first.</p>
<c:choose><c:when test="${empty bookings}"><p>No lesson requests have been made.</p></c:when><c:otherwise><c:forEach items="${bookings}" var="booking"><article class="ds-feature-card"><h2><c:out value="${booking.startTime}" /></h2><p>Booking <c:out value="${booking.id}" /> Â· Student <c:out value="${booking.studentId}" /> Â· Package <c:out value="${booking.enrollmentId}" /></p><p>Status: <span class="status-badge" data-status="<c:out value='${booking.status}' />"><c:out value="${booking.status}" /></span></p><c:if test="${booking.status eq 'PENDING'}"><p>Queue position: <c:out value="${queuePositions[booking.id]}" /></p><c:choose><c:when test="${queuePositions[booking.id] eq 1}"><form method="post" action="<c:url value='/admin/bookings/process-next' />"><input type="hidden" name="<c:out value='${csrfParameterName}' />" value="<c:out value='${csrfToken}' />"><input type="hidden" name="bookingId" value="<c:out value='${booking.id}' />"><label>Instructor <select name="instructorId" required><c:forEach items="${instructors}" var="instructor"><option value="<c:out value='${instructor.id}' />"><c:out value="${instructor.name}" /></option></c:forEach></select></label><label>Vehicle <select name="vehicleId" required><c:forEach items="${vehicles}" var="vehicle"><option value="<c:out value='${vehicle.id}' />"><c:out value="${vehicle.registrationNumber}" /> â€” <c:out value="${vehicle.make}" /> <c:out value="${vehicle.model}" /></option></c:forEach></select></label><button type="submit">Process next request (assign for instructor approval)</button></form></c:when><c:otherwise><p>Process earlier pending requests first.</p></c:otherwise></c:choose></c:if><c:if test="${booking.status eq 'REJECTED'}"><p>Request declined: <c:out value="${booking.rejectionReason}" /></p></c:if><c:if test="${booking.status eq 'CONFIRMED'}"><form method="post" action="<c:url value='/admin/bookings/reassign' />"><input type="hidden" name="<c:out value='${csrfParameterName}' />" value="<c:out value='${csrfToken}' />"><input type="hidden" name="bookingId" value="<c:out value='${booking.id}' />"><label>Reassign instructor <select name="instructorId"><c:forEach items="${instructors}" var="instructor"><option value="${instructor.id}"><c:out value="${instructor.name}" /></option></c:forEach></select></label><label>Vehicle <select name="vehicleId"><c:forEach items="${vehicles}" var="vehicle"><option value="${vehicle.id}"><c:out value="${vehicle.registrationNumber}" /></option></c:forEach></select></label><button type="submit">Reassign</button></form><c:if test="${booking.status eq 'CONFIRMED'}"><p>Instructor <c:out value="${booking.instructorId}" /> Â· Vehicle <c:out value="${booking.vehicleId}" /></p><form method="post" action="<c:url value='/admin/bookings/complete' />"><input type="hidden" name="<c:out value='${csrfParameterName}' />" value="<c:out value='${csrfToken}' />"><input type="hidden" name="bookingId" value="<c:out value='${booking.id}' />"><button type="submit">Mark complete</button></form></c:if><c:if test="${booking.status ne 'COMPLETED' and booking.status ne 'CANCELLED'}"><form method="post" action="<c:url value='/admin/bookings/force-cancel' />" data-confirm="Confirm force-cancelling this booking. Enter the reason to continue." data-confirm-reason="true"><input type="hidden" name="<c:out value='${csrfParameterName}' />" value="<c:out value='${csrfToken}' />"><input type="hidden" name="bookingId" value="<c:out value='${booking.id}' />"><label>Reason <input name="reason" maxlength="300" required></label><button type="submit">Force cancel</button></form></c:if></c:if></article></c:forEach></c:otherwise></c:choose>
</div></main><%@ include file="/WEB-INF/views/common/footer.jspf" %></body></html>
