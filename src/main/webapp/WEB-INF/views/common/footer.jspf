        <div class="ds-footer-about">
            <a class="ds-footer-brand" href="<c:url value='/' />"><span class="ds-wordmark">DriveSpark<span>Academy</span></span></a>
            <p>Driving lessons and practical feedback.</p>
        </div>
        <div><h2>Lessons</h2>
            <a href="<c:url value='/packages' />">Packages</a><a href="<c:url value='/instructors' />">Instructors</a><a href="<c:url value='/public/reviews' />">Reviews</a>
        </div>
        <div><h2>The academy</h2>
            <a href="<c:url value='/about' />">About us</a><a href="<c:url value='/faq' />">Questions</a><a href="<c:url value='/contact' />">Contact</a>
        </div>
        <div><h2>Contact us</h2><%@ include file="/WEB-INF/views/common/components/school-contact.jspf" %><a href="<c:url value='/contact' />">Send a message</a></div>
    </div>
    <%-- Placeholders and sample figures are explained here rather than presented as verified claims. --%>
