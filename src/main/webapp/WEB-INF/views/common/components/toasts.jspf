<%--
============================================================
MEMBER   : IT26101136 - [Name]
MODULE   : Shared UI
FILE     : toasts.jspf
WHAT IT DOES (simple words): Shows the shared toasts block.
REAL-LIFE EXAMPLE: Shared signs help everyone find their way around the school.
OOP USED : Not applicable (shared presentation)
CRUD     : Displays existing data; does not save records
============================================================
--%>
<%-- This block shows toasts. The including page controller supplies this block through model attributes. --%>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:if test="${not empty success or not empty message or not empty formError or not empty error}"><div class="ds-toast-stack" aria-live="polite"><c:if test="${not empty success or not empty message}"><div class="ds-toast ds-toast-success" role="status"><span aria-hidden="true">&#10003;</span><span><c:out value="${success}" /><c:out value="${message}" /></span><button type="button" class="ds-toast-dismiss" aria-label="Dismiss message">&#215;</button></div></c:if><c:if test="${not empty formError or not empty error}"><div class="ds-toast ds-toast-error" role="alert"><span aria-hidden="true">!</span><span><c:out value="${formError}" /><c:out value="${error}" /></span><button type="button" class="ds-toast-dismiss" aria-label="Dismiss error">&#215;</button></div></c:if></div></c:if>
