<%-- Module owner: IT26101136 --%>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:if test="${not empty success or not empty message or not empty formError or not empty error}"><div class="ds-toast-stack" aria-live="polite"><c:if test="${not empty success or not empty message}"><div class="ds-toast ds-toast-success" role="status"><span aria-hidden="true">✓</span><span><c:out value="${success}" /><c:out value="${message}" /></span><button type="button" class="ds-toast-dismiss" aria-label="Dismiss message">×</button></div></c:if><c:if test="${not empty formError or not empty error}"><div class="ds-toast ds-toast-error" role="alert"><span aria-hidden="true">!</span><span><c:out value="${formError}" /><c:out value="${error}" /></span><button type="button" class="ds-toast-dismiss" aria-label="Dismiss error">×</button></div></c:if></div></c:if>
