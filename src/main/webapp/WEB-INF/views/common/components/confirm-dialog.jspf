<%--
============================================================
MEMBER   : IT26101136 - [Name]
MODULE   : Shared UI
FILE     : confirm-dialog.jspf
WHAT IT DOES (simple words): Shows the shared confirm dialog block.
REAL-LIFE EXAMPLE: Shared signs help everyone find their way around the school.
OOP USED : Not applicable (shared presentation)
CRUD     : Displays existing data; does not save records
============================================================
--%>
<%-- This block shows confirm dialog. The including page controller supplies this block through model attributes. --%>
<dialog class="ds-confirm-dialog" id="ds-confirm-dialog" aria-labelledby="ds-confirm-title" aria-describedby="ds-confirm-message"><form method="dialog" class="ds-confirm-card"><button class="ds-modal-close" value="cancel" aria-label="Close confirmation">&#215;</button><p class="ds-eyebrow">PLEASE CONFIRM</p><h2 id="ds-confirm-title">Confirm your choice</h2><p id="ds-confirm-message">Check the details before you continue.</p><div id="ds-confirm-reason-wrap" hidden><label for="ds-confirm-reason">Reason</label><textarea id="ds-confirm-reason" rows="3"></textarea></div><div class="ds-confirm-actions"><button class="ds-button ds-button-outline" value="cancel">Go back</button><button class="ds-button ds-button-danger" id="ds-confirm-continue" value="confirm">Confirm</button></div></form></dialog>
