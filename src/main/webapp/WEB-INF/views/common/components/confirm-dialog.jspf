<%-- Module owner: IT26101136 --%>
<dialog class="ds-confirm-dialog" id="ds-confirm-dialog" aria-labelledby="ds-confirm-title"><form method="dialog" class="ds-confirm-card"><button class="ds-modal-close" value="cancel" aria-label="Close confirmation">×</button><p class="ds-eyebrow">PLEASE CONFIRM</p><h2 id="ds-confirm-title">Are you sure?</h2><p id="ds-confirm-message">This action may affect your account or schedule.</p><div id="ds-confirm-reason-wrap" hidden><label for="ds-confirm-reason">Reason</label><textarea id="ds-confirm-reason" rows="3"></textarea></div><div class="ds-confirm-actions"><button class="ds-button ds-button-outline" value="cancel">Go back</button><button class="ds-button ds-button-danger" id="ds-confirm-continue" value="confirm">Continue</button></div></form></dialog>
