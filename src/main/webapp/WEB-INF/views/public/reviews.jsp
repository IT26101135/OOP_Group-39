<%-- Module owner: IT26101136 --%>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" session="false" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><c:url value="/css/tailwind.css" var="appCssUrl" />
<!DOCTYPE html><html lang="en"><head>
    <meta name="description" content="Student reviews at DriveSpark Academy. Explore lessons, learning resources and driving school information.">
    <meta name="theme-color" content="#0B1120">
    <link rel="icon" type="image/svg+xml" href="<c:url value='/images/favicon.svg' />"><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Student reviews</title><link rel="stylesheet" href="<c:out value='${appCssUrl}' />"></head><body><%@ include file="/WEB-INF/views/common/navbar.jspf" %><main id="main-content" class="ds-container ds-section"><p class="ds-eyebrow">LEARNER FEEDBACK</p><h1>Student reviews</h1><p class="ds-page-intro">Approved feedback from learners about their experience at the academy.</p><c:choose><c:when test="${empty reviews}"><section class="ds-empty-state"><span class="ds-empty-icon" aria-hidden="true">★</span><h2>Reviews are on the way</h2><p>No approved reviews are available yet. Once feedback is approved, it will appear here.</p></section></c:when><c:otherwise><div class="ds-feature-grid"><c:forEach items="${reviews}" var="review"><article class="ds-feature-card ds-review-card"><c:set var="ratingValue" value="${review.rating}"/><%@ include file="/WEB-INF/views/common/components/star-display.jspf" %><p class="ds-review-quote">“<c:out value="${review.comment}" />”</p><p class="ds-review-meta">DriveSpark learner <span>·</span> <time><c:out value="${review.createdAt}" /></time></p></article></c:forEach></div></c:otherwise></c:choose></main><%@ include file="/WEB-INF/views/common/footer.jspf" %></body></html>
