<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" session="false" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><c:url value="/css/tailwind.css" var="appCssUrl" />
<!DOCTYPE html><html lang="en"><head>
    <meta name="description" content="Contact us at DriveSpark Academy. Explore lessons, learning resources and driving school information.">
    <meta name="theme-color" content="#0B1120">
    <link rel="icon" type="image/svg+xml" href="<c:url value='/images/favicon.svg' />"><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Contact us</title><link rel="stylesheet" href="<c:out value='${appCssUrl}' />"></head><body><%@ include file="/WEB-INF/views/common/navbar.jspf" %><main id="main-content" class="ds-container ds-section"><h1>Contact us</h1><c:if test="${messageSent}"><p role="status">Your message has been received.</p></c:if><c:if test="${not empty formError}"><p role="alert"><c:out value="${formError}" /></p></c:if><div class="ds-contact-grid"><aside class="ds-feature-card"><p class="ds-eyebrow">WE ARE HERE TO HELP</p><h2>Let us talk about your learning goals.</h2><p>Send a message and the academy team can follow up with you.</p><div class="ds-contact-detail"><strong>Office</strong><span>Colombo, Sri Lanka (demo location)</span></div><div class="ds-contact-detail"><strong>Opening hours</strong><span>Monday?Saturday, 8:00 AM?6:00 PM</span></div></aside><form method="post" action="<c:url value='/contact' />"><input type="hidden" name="<c:out value='${csrfParameterName}' />" value="<c:out value='${csrfToken}' />"><label>Name <input name="name" required maxlength="100"></label><label>Email <input name="email" type="email" required></label><label>Message <textarea name="message" minlength="10" maxlength="2000" required></textarea></label><button type="submit">Send message</button></form></div></main><%@ include file="/WEB-INF/views/common/footer.jspf" %></body></html>
