<%-- Module owner: IT26101135 --%>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" session="false" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><c:url value="/css/tailwind.css" var="appCssUrl" />
<!DOCTYPE html><html lang="en"><head>
    <meta name="description" content="Learning progress at DriveSpark Academy. Explore lessons, learning resources and driving school information.">
    <meta name="theme-color" content="#0B1120">
    <link rel="icon" type="image/svg+xml" href="<c:url value='/images/favicon.svg' />"><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Learning progress</title><link rel="stylesheet" href="<c:out value='${appCssUrl}' />"></head><body><%@ include file="/WEB-INF/views/common/navbar.jspf" %><main id="main-content" class="ds-container ds-section ds-dashboard-shell"><%@ include file="/WEB-INF/views/common/dashboard-sidebar.jspf" %><div class="ds-dashboard-content"><h1>My progress</h1><p>Lessons completed: <c:out value="${progress.lessonsCompleted}" /></p><p>Hours driven: <c:out value="${progress.hoursDriven}" /></p><h2>Instructor notes</h2><c:choose><c:when test="${empty progress.lessonRecords}"><p>No instructor notes have been recorded yet.</p></c:when><c:otherwise><c:forEach items="${progress.lessonRecords}" var="record"><article class="ds-feature-card"><h3>Lesson <c:out value="${record.bookingId}" /></h3><p><c:out value="${record.notes}" /></p><p>Skill ratings: <c:forEach items="${record.skillRatings}" var="skill"><c:out value="${skill.key}" />: <c:out value="${skill.value}" />/5; </c:forEach></p><p>Ready for test: <c:out value="${record.readyForTest}" /></p></article></c:forEach></c:otherwise></c:choose></div></main><%@ include file="/WEB-INF/views/common/footer.jspf" %></body></html>
