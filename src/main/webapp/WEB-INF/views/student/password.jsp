<%-- Module owner: IT26101135 --%>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" session="false" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:url value="/css/tailwind.css" var="appCssUrl" />
<!DOCTYPE html><html lang="en"><head>
    <meta name="description" content="Change password at DriveSpark Academy. Explore lessons, learning resources and driving school information.">
    <meta name="theme-color" content="#0B1120">
    <link rel="icon" type="image/svg+xml" href="<c:url value='/images/favicon.svg' />"><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Change password</title><link rel="stylesheet" href="<c:out value='${appCssUrl}' />"></head>
<body><%@ include file="/WEB-INF/views/common/navbar.jspf" %><main id="main-content" class="ds-container ds-section ds-dashboard-shell"><%@ include file="/WEB-INF/views/common/dashboard-sidebar.jspf" %><div class="ds-dashboard-content"><h1>Change password</h1><c:if test="${not empty formError}"><p role="alert"><c:out value="${formError}" /></p></c:if><form method="post" action="<c:url value='/student/password' />"><input type="hidden" name="<c:out value='${csrfParameterName}' />" value="<c:out value='${csrfToken}' />"><label>Current password <span data-password-wrap><input id="current-password" type="password" name="currentPassword" required autocomplete="current-password"><button class="ds-password-toggle" type="button" data-password-toggle="current-password" aria-label="Show current password" aria-pressed="false">Show</button></span></label><label>New password <span data-password-wrap><input id="new-password" type="password" data-password-strength="new-strength" name="password" minlength="8" required autocomplete="new-password"><button class="ds-password-toggle" type="button" data-password-toggle="new-password" aria-label="Show new password" aria-pressed="false">Show</button></span><small id="new-strength" aria-live="polite">Use 8+ characters, with a letter and number.</small></label><label>Confirm new password <span data-password-wrap><input id="confirm-new-password" type="password" name="confirmPassword" minlength="8" required autocomplete="new-password"><button class="ds-password-toggle" type="button" data-password-toggle="confirm-new-password" aria-label="Show password confirmation" aria-pressed="false">Show</button></span></label><button type="submit">Save password</button></form></div></main><%@ include file="/WEB-INF/views/common/footer.jspf" %></body></html>
