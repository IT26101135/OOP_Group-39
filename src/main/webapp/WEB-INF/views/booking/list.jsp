<%-- Module owner: IT26101134 --%>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" session="false" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:url value="/css/tailwind.css" var="appCssUrl" />
<!DOCTYPE html><html lang="en"><head>
    <meta name="description" content="My lesson requests at DriveSpark Academy. Explore lessons, learning resources and driving school information.">
    <meta name="theme-color" content="#0B1120">
    <link rel="icon" type="image/svg+xml" href="<c:url value='/images/favicon.svg' />"><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>My lesson requests</title><link rel="stylesheet" href="<c:out value='${appCssUrl}' />"></head>
<body><%@ include file="/WEB-INF/views/common/navbar.jspf" %><main id="main-content" class="ds-container ds-section ds-dashboard-shell"><%@ include file="/WEB-INF/views/common/dashboard-sidebar.jspf" %><div class="ds-dashboard-content">
<c:if test="${not empty success}"><p role="status"><c:out value="${success}" /></p></c:if>
<p class="ds-eyebrow">STUDENT WORKSPACE</p><h1>My lessons</h1><ol class="ds-wizard-steps" aria-label="Booking steps"><li aria-current="step">1 <span>Instructor</span></li><li>2 <span>Date</span></li><li>3 <span>Time slot</span></li><li>4 <span>Confirm</span></li></ol><section class="ds-booking-panel"><h2>Request a lesson</h2><p>Choose an instructor and date to see available one-hour slots. Time is checked again when submitted.</p>
<c:choose><c:when test="${empty packages}"><p>There are no active packages available.</p></c:when><c:otherwise>
<form method="get" action="<c:url value='/bookings' />"><label>Instructor <select name="instructorId" required><c:forEach items="${instructors}" var="instructor"><option value="<c:out value='${instructor.id}' />" <c:if test="${selectedInstructorId eq instructor.id}">selected</c:if>><c:out value="${instructor.name}" /></option></c:forEach></select></label><label>Date <input type="date" name="date" value="<c:out value='${selectedDate}' />" required></label><button type="submit">Find available times</button></form>
<c:if test="${not empty slotError}"><p role="alert"><c:out value="${slotError}" /></p></c:if>
<c:if test="${not empty selectedDate}"><c:choose><c:when test="${empty availableSlots}"><p>No lesson slots are available for this instructor and date.</p></c:when><c:otherwise><form method="post" action="<c:url value='/bookings' />"><input type="hidden" name="<c:out value='${csrfParameterName}' />" value="<c:out value='${csrfToken}' />"><input type="hidden" name="instructorId" value="<c:out value='${selectedInstructorId}' />"><label>Package <select name="packageId" required><c:forEach items="${packages}" var="learningPackage"><option value="<c:out value='${learningPackage.id}' />"><c:out value="${learningPackage.name}" /> â€” LKR <c:out value="${learningPackage.price}" /></option></c:forEach></select></label><fieldset class="ds-slot-fieldset"><legend>Available time</legend><div class="ds-slot-options"><c:forEach items="${availableSlots}" var="slot"><label class="ds-slot-chip"><input type="radio" name="startTime" value="<c:out value='${slot}' />" required><span><c:out value="${slot}" /></span></label></c:forEach></div></fieldset><button type="submit">Request lesson</button></form></c:otherwise></c:choose></c:if>
</c:otherwise></c:choose>
</section><h2>My requests</h2><c:choose><c:when test="${empty bookings}"><p>You have no lesson requests yet.</p></c:when><c:otherwise><c:forEach items="${bookings}" var="booking"><article class="ds-feature-card"><h3><c:out value="${booking.startTime}" /></h3><p>Enrollment: <c:out value="${booking.enrollmentId}" /> Â· Status: <span class="status-badge" data-status="<c:out value='${booking.status}' />"><c:out value="${booking.status}" /></span></p><c:if test="${booking.status eq 'PENDING'}"><p>Queue position: <c:out value="${queuePositions[booking.id]}" /></p></c:if><c:if test="${booking.status eq 'REJECTED'}"><p>Reason: <c:out value="${booking.rejectionReason}" /></p></c:if><c:if test="${booking.status eq 'CONFIRMED'}"><p>Instructor: <c:out value="${booking.instructorId}" /> Â· Vehicle: <c:out value="${booking.vehicleId}" /></p></c:if><c:if test="${booking.status eq 'PENDING' or booking.status eq 'CONFIRMED'}"><form method="post" action="<c:url value='/bookings/cancel' />" data-confirm="Cancel this lesson request? The 24-hour rule applies."><input type="hidden" name="<c:out value='${csrfParameterName}' />" value="<c:out value='${csrfToken}' />"><input type="hidden" name="bookingId" value="<c:out value='${booking.id}' />"><button type="submit">Cancel request</button></form><form method="post" action="<c:url value='/bookings/reschedule' />" data-confirm="Reschedule this lesson? A new request will go to the back of the queue."><input type="hidden" name="<c:out value='${csrfParameterName}' />" value="<c:out value='${csrfToken}' />"><input type="hidden" name="bookingId" value="<c:out value='${booking.id}' />"><label>New start time <input type="datetime-local" name="startTime" required></label><button type="submit">Reschedule (creates a new queue request)</button></form></c:if><c:if test="${booking.status eq 'CANCELLED'}"><form method="post" action="<c:url value='/bookings/delete' />"><input type="hidden" name="<c:out value='${csrfParameterName}' />" value="<c:out value='${csrfToken}' />"><input type="hidden" name="bookingId" value="<c:out value='${booking.id}' />"><button type="submit">Delete cancelled request</button></form></c:if></article></c:forEach></c:otherwise></c:choose>
</div></main><%@ include file="/WEB-INF/views/common/footer.jspf" %></body></html>
