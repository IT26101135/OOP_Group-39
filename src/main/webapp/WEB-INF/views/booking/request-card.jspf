<%--
============================================================
MEMBER   : IT26101134 - [Name]
MODULE   : Bookings, FIFO queue and scheduling
FILE     : request-card.jspf
WHAT IT DOES (simple words): Shows request card information and forms.
REAL-LIFE EXAMPLE: A reception waiting line handles the oldest request first.
OOP USED : Not applicable (JSP presentation)
CRUD     : See the labelled operations; model and view files support these operations.
============================================================
--%>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%-- BookingController supplies one owned request and its FIFO position for this card. --%>
<%-- BookingController supplies this record card. --%>
<article class="ds-feature-card"><div class="mb-4 flex flex-wrap items-start justify-between gap-3"><div><p class="ds-eyebrow"><c:out value="${'LESSON'}" /></p><h3 class="text-xl"><c:out value="${publicDisplay.date(booking.startTime.toLocalDate())}" /></h3><p><c:out value="${publicDisplay.time(booking.startTime.toLocalTime())}" /> to <c:out value="${publicDisplay.time(booking.endTime.toLocalTime())}" /></p></div><span class="status-badge" data-status="${booking.status}"><c:out value="${publicDisplay.label(booking.status)}" /></span></div>
<p class="my-3"><a class="ds-home-text-link" href="<c:url value='/bookings/${booking.id}/details' />">View booking details</a></p>
<p>Package: <c:out value="${bookingPackages[booking.id].packageName}" /> &middot; Course type: <c:out value="${publicDisplay.label(bookingPackages[booking.id].type)}" /></p>
<p>Enrollment <c:out value="${accountDisplay.enrollment(booking.enrollmentId)}" /></p>
<c:if test="${booking.status eq 'PENDING'}"><c:choose><c:when test="${booking.instructorId == null}"><p class="mt-3"><span class="ds-queue-position">Position in waiting list <c:out value="${queuePositions[booking.id]}" /></span></p><p class="mt-2">Your request is waiting for assignment.</p></c:when><c:otherwise><p class="mt-3 text-indigo-200">Assigned - waiting for instructor approval.</p></c:otherwise></c:choose></c:if>
<c:if test="${not empty booking.instructorId}"><p>Instructor <c:out value="${accountDisplay.person(booking.instructorId)}" /> - Vehicle <c:out value="${accountDisplay.vehicle(booking.vehicleId)}" /></p></c:if>
<c:if test="${not empty booking.rejectionReason}"><p class="mt-3 rounded-xl border border-amber-300/20 bg-amber-400/10 p-3 text-amber-100"><c:out value="${booking.rejectionReason}" /> <a class="ds-home-text-link" href="<c:url value='/enrollments' />">My enrollments</a></p></c:if>
<c:if test="${booking.status eq 'PENDING' or booking.status eq 'CONFIRMED'}">
<details class="mt-5"><summary>Change this request</summary><p>Changes need advance notice. A rescheduled request joins the back of the queue.</p>
<%-- BookingController rechecks ownership, the notice period and availability on submission. --%>
<%-- BookingController supplies this form and its original field names. --%>
<form class="mt-4 grid gap-3 sm:grid-cols-2" method="post" action="<c:url value='/bookings/reschedule' />" data-confirm="Request a new lesson time? Earlier requests will be handled first."><input type="hidden" name="<c:out value='${csrfParameterName}' />" value="<c:out value='${csrfToken}' />"><input type="hidden" name="bookingId" value="${booking.id}"><div><label for="reschedule-${booking.id}">New start time</label><input class="block w-full" id="reschedule-${booking.id}" type="datetime-local" name="startTime" required></div><div class="flex items-end"><button class="ds-button" type="submit">Request new time</button></div></form>
<%-- BookingController supplies this form and its original field names. --%>
<form class="mt-4" method="post" action="<c:url value='/bookings/cancel' />" data-confirm="Cancel this lesson request? Cancellation must meet the required notice period."><input type="hidden" name="<c:out value='${csrfParameterName}' />" value="<c:out value='${csrfToken}' />"><input type="hidden" name="bookingId" value="${booking.id}"><button class="ds-button ds-button-danger" type="submit">Cancel request</button></form></details></c:if>
<c:if test="${booking.status eq 'CANCELLED'}"><%-- BookingController supplies this form and its original field names. --%>
<form class="mt-4" method="post" action="<c:url value='/bookings/delete' />" data-confirm="Delete this cancelled request?"><input type="hidden" name="<c:out value='${csrfParameterName}' />" value="<c:out value='${csrfToken}' />"><input type="hidden" name="bookingId" value="${booking.id}"><button class="ds-button ds-button-danger" type="submit">Delete cancelled request</button></form></c:if>
</article>