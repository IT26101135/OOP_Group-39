<%-- Module owner: IT26101133 --%>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" session="false" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><c:url value="/css/tailwind.css" var="appCssUrl" />
<!DOCTYPE html><html lang="en"><head>
    <meta name="description" content="My availability at DriveSpark Academy. Explore lessons, learning resources and driving school information.">
    <meta name="theme-color" content="#0B1120">
    <link rel="icon" type="image/svg+xml" href="<c:url value='/images/favicon.svg' />"><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>My availability</title><link rel="stylesheet" href="<c:out value='${appCssUrl}' />"></head><body><%@ include file="/WEB-INF/views/common/navbar.jspf" %><main id="main-content" class="ds-container ds-section ds-dashboard-shell"><%@ include file="/WEB-INF/views/common/dashboard-sidebar.jspf" %><div class="ds-dashboard-content"><h1>My availability and leave</h1><c:if test="${not empty success}"><p role="status"><c:out value="${success}" /></p></c:if><h2>Add working hours</h2><form method="post" action="<c:url value='/instructor/availability' />"><input type="hidden" name="<c:out value='${csrfParameterName}' />" value="<c:out value='${csrfToken}' />"><label>Day <select name="dayOfWeek"><c:forEach items="${days}" var="day"><option value="<c:out value='${day}' />"><c:out value="${day}" /></option></c:forEach></select></label><label>Start <input type="time" name="startTime" required></label><label>End <input type="time" name="endTime" required></label><button type="submit">Add availability</button></form><h2>Weekly availability</h2><c:choose><c:when test="${empty availability}"><p>No working hours have been set.</p></c:when><c:otherwise><c:forEach items="${availability}" var="block"><p><c:out value="${block.dayOfWeek}" />: <c:out value="${block.startTime}" />–<c:out value="${block.endTime}" /><form method="post" action="<c:url value='/instructor/availability/delete' />"><input type="hidden" name="<c:out value='${csrfParameterName}' />" value="<c:out value='${csrfToken}' />"><input type="hidden" name="id" value="<c:out value='${block.id}' />"><button type="submit">Remove</button></form></p></c:forEach></c:otherwise></c:choose><h2>Mark a day off</h2><form method="post" action="<c:url value='/instructor/availability/leave' />"><input type="hidden" name="<c:out value='${csrfParameterName}' />" value="<c:out value='${csrfToken}' />"><label>Date <input type="date" name="date" required></label><label>Reason <input name="reason" maxlength="300" required></label><button type="submit">Add leave</button></form><h2>Leave days</h2><c:forEach items="${leaves}" var="leave"><p><c:out value="${leave.date}" /> — <c:out value="${leave.reason}" /><form method="post" action="<c:url value='/instructor/availability/leave/delete' />"><input type="hidden" name="<c:out value='${csrfParameterName}' />" value="<c:out value='${csrfToken}' />"><input type="hidden" name="id" value="<c:out value='${leave.id}' />"><button type="submit">Remove leave</button></form></p></c:forEach></div></main><%@ include file="/WEB-INF/views/common/footer.jspf" %></body></html>
