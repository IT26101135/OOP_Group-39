<%-- Module owner: IT26101133 --%>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" session="false" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:url value="/css/tailwind.css" var="appCssUrl" />
<!DOCTYPE html>
<html lang="en"><head>
    <meta name="description" content="Instructor schedule at DriveSpark Academy. Explore lessons, learning resources and driving school information.">
    <meta name="theme-color" content="#0B1120">
    <link rel="icon" type="image/svg+xml" href="<c:url value='/images/favicon.svg' />"><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Instructor schedule</title><link rel="stylesheet" href="<c:out value='${appCssUrl}' />"></head>
<body><%@ include file="/WEB-INF/views/common/navbar.jspf" %><main id="main-content" class="ds-container ds-section ds-dashboard-shell"><%@ include file="/WEB-INF/views/common/dashboard-sidebar.jspf" %><div class="ds-dashboard-content">
<h1 id="assigned-lessons">Instructor dashboard</h1><c:if test="${not empty success}"><p role="status"><c:out value="${success}" /></p></c:if>
<div class="ds-feature-grid"><article class="ds-feature-card"><h2>Today</h2><p><c:out value="${todayCount}" /> lessons</p></article><article class="ds-feature-card"><h2>Upcoming</h2><p><c:out value="${upcomingCount}" /> lessons</p></article><article class="ds-feature-card"><h2>Students</h2><p><c:out value="${studentCount}" /></p></article><article class="ds-feature-card"><h2>Average rating</h2><p><c:out value="${averageRating}" /> / 5</p></article></div>
<h2>My reviews</h2><c:choose><c:when test="${empty ownReviews}"><p>No reviews have been submitted for your lessons.</p></c:when><c:otherwise><c:forEach items="${ownReviews}" var="review"><article class="ds-feature-card"><p><c:out value="${review.rating}" /> / 5 ? <span class="status-badge" data-status="<c:out value='${review.status}' />"><c:out value="${review.status}" /></span></p><p><c:out value="${review.comment}" /></p></article></c:forEach></c:otherwise></c:choose><h2>Assigned lessons</h2><c:choose><c:when test="${empty bookings}"><p>You have no assigned lessons.</p></c:when><c:otherwise><c:forEach items="${bookings}" var="booking"><article class="ds-feature-card"><h3><c:out value="${booking.startTime}" /></h3><p>Student: <c:out value="${studentDetails[booking.id].name}" /> (<c:out value="${booking.studentId}" />) · Vehicle: <c:out value="${booking.vehicleId}" /></p><p>Status: <span class="status-badge" data-status="<c:out value='${booking.status}' />"><c:out value="${booking.status}" /></span></p>
<c:if test="${booking.status eq 'PENDING'}"><form method="post" action="<c:url value='/instructor/accept' />"><input type="hidden" name="<c:out value='${csrfParameterName}' />" value="<c:out value='${csrfToken}' />"><input type="hidden" name="bookingId" value="<c:out value='${booking.id}' />"><button type="submit">Accept lesson</button></form><form method="post" action="<c:url value='/instructor/decline' />" data-confirm="Confirm declining this lesson. Enter a reason to continue." data-confirm-reason="true"><input type="hidden" name="<c:out value='${csrfParameterName}' />" value="<c:out value='${csrfToken}' />"><input type="hidden" name="bookingId" value="<c:out value='${booking.id}' />"><label>Reason <input name="reason" maxlength="300" required></label><button type="submit">Decline lesson</button></form></c:if><c:if test="${booking.status eq 'CONFIRMED'}"><form method="post" action="<c:url value='/instructor/complete' />"><input type="hidden" name="<c:out value='${csrfParameterName}' />" value="<c:out value='${csrfToken}' />"><input type="hidden" name="bookingId" value="<c:out value='${booking.id}' />"><button type="submit">Mark completed</button></form><form method="post" action="<c:url value='/instructor/no-show' />"><input type="hidden" name="<c:out value='${csrfParameterName}' />" value="<c:out value='${csrfToken}' />"><input type="hidden" name="bookingId" value="<c:out value='${booking.id}' />"><button type="submit">Mark no-show</button></form></c:if>
<c:if test="${booking.status eq 'COMPLETED'}"><h4>Lesson notes and skill ratings</h4><form method="post" action="<c:url value='/instructor/lesson-notes' />"><input type="hidden" name="<c:out value='${csrfParameterName}' />" value="<c:out value='${csrfToken}' />"><input type="hidden" name="bookingId" value="<c:out value='${booking.id}' />"><label>Notes <textarea name="notes" maxlength="2000" required></textarea></label><label>Clutch control <input type="number" name="clutchControl" min="1" max="5" required></label><label>Parking <input type="number" name="parking" min="1" max="5" required></label><label>Road signs <input type="number" name="roadSigns" min="1" max="5" required></label><label>Lane discipline <input type="number" name="laneDiscipline" min="1" max="5" required></label><label><input type="checkbox" name="readyForTest" value="true"> Ready for test</label><button type="submit">Save lesson record</button></form></c:if>
</article></c:forEach></c:otherwise></c:choose></div></main><%@ include file="/WEB-INF/views/common/footer.jspf" %></body></html>
