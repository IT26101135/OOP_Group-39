<%-- Module owner: IT26101137 --%>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" session="false" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:url value="/css/tailwind.css" var="appCssUrl" />
<!DOCTYPE html>
<html lang="en"><head>
    <meta name="description" content="Reviews at DriveSpark Academy. Explore lessons, learning resources and driving school information.">
    <meta name="theme-color" content="#0B1120">
    <link rel="icon" type="image/svg+xml" href="<c:url value='/images/favicon.svg' />"><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Reviews</title><link rel="stylesheet" href="<c:out value='${appCssUrl}' />"></head>
<body><%@ include file="/WEB-INF/views/common/navbar.jspf" %><main id="main-content" class="ds-container ds-section ds-dashboard-shell"><%@ include file="/WEB-INF/views/common/dashboard-sidebar.jspf" %><div class="ds-dashboard-content"><h1>Reviews</h1>
<c:if test="${not empty success}"><p role="status"><c:out value="${success}" /></p></c:if>
<c:if test="${navRole eq 'STUDENT'}"><h2>Write a review</h2><form method="post" action="<c:url value='/reviews' />"><input type="hidden" name="<c:out value='${csrfParameterName}' />" value="<c:out value='${csrfToken}' />"><label>Completed lesson <select name="bookingId" required><option value="">Choose lesson</option><c:forEach items="${completedBookings}" var="completed"><option value="<c:out value='${completed.id}' />"><c:out value="${completed.startTime}" /> ? <c:out value="${completed.id}" /></option></c:forEach></select></label><c:set var="ratingFieldName" value="rating"/><c:set var="ratingLabel" value="Rating"/><c:set var="ratingValue" value="${empty param.rating ? 5 : param.rating}"/><%@ include file="/WEB-INF/views/common/components/star-input.jspf" %><label>Comment <textarea name="comment" minlength="10" maxlength="1000" required></textarea></label><button type="submit">Submit review</button></form></c:if>
<h2>Visible reviews</h2><c:choose><c:when test="${empty reviews}"><p>No reviews to show yet.</p></c:when><c:otherwise><c:forEach items="${reviews}" var="review"><article class="ds-feature-card"><h3><c:out value="${review.rating}" /> / 5</h3><p><c:out value="${review.comment}" /></p><p>Status: <span class="status-badge" data-status="<c:out value='${review.status}' />"><c:out value="${review.status}" /></span></p><c:if test="${navRole eq 'STUDENT' and review.studentId eq currentUserId}"><form method="post" action="<c:url value='/reviews/update' />"><input type="hidden" name="<c:out value='${csrfParameterName}' />" value="<c:out value='${csrfToken}' />"><input type="hidden" name="reviewId" value="<c:out value='${review.id}' />"><c:set var="ratingFieldName" value="rating"/><c:set var="ratingLabel" value="Update rating"/><c:set var="ratingValue" value="${review.rating}"/><%@ include file="/WEB-INF/views/common/components/star-input.jspf" %><label>Update comment <textarea name="comment" minlength="10" maxlength="1000" required><c:out value="${review.comment}" /></textarea></label><button type="submit">Update</button></form><form method="post" action="<c:url value='/reviews/delete' />"><input type="hidden" name="<c:out value='${csrfParameterName}' />" value="<c:out value='${csrfToken}' />"><input type="hidden" name="reviewId" value="<c:out value='${review.id}' />"><button type="submit">Delete review</button></form></c:if></article></c:forEach></c:otherwise></c:choose>
</div></main><%@ include file="/WEB-INF/views/common/footer.jspf" %></body></html>
